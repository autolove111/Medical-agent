# ========================================
# MedLabAgent example environment file
# ========================================

# ========================================
# LLM / Vision APIs
# ========================================
DASHSCOPE_API_KEY=your_dashscope_api_key
VISION_MODEL=qwen3-vl-32b-thinking
DASHSCOPE_MODEL=qwen3-vl-32b-thinking
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ========================================
# Database
# ========================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/medlab_db
SPRING_DATASOURCE_USERNAME=medlab_user
SPRING_DATASOURCE_PASSWORD=medlab_password
DATABASE_URL=postgresql://medlab_user:medlab_password@localhost:5432/medlab_db

# ========================================
# Auth
# ========================================
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRATION=86400000

# ========================================
# Service URLs
# ========================================
JAVA_BACKEND_URL=http://localhost:8080
LANGCHAIN_SERVICE_URL=http://localhost:8000
OCR_SERVICE_URL=http://localhost:8001
SERVER_URL=http://localhost:8080
OCR_ACCESS_URL=http://localhost:8080

# ========================================
# Upload / Storage
# ========================================
UPLOAD_DIR=./uploads
MEDLAB_UPLOAD_DIR=./uploads

# ========================================
# Redis
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
OCR_CACHE_TTL_SECONDS=3600

# ========================================
# Local Python models
# ========================================
LLM_MODEL_PATH=./models/Qwen2.5-0.5B-Instruct
RAG_LOCAL_EMBEDDING_PATH=./models/bce-embedding-base_v1

# ========================================
# Timeouts / Logging
# ========================================
HTTP_TIMEOUT=30
LLM_API_TIMEOUT=60
JAVA_LOG_LEVEL=INFO
PYTHON_LOG_LEVEL=INFO

# ========================================
# LangSmith (optional)
# ========================================
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medlab-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ========================================
# Optional feature flags
# ========================================
MEDLAB_DESENSITIZE_ENABLED=true
